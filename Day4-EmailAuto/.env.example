# Copy to .env and fill in real values. Do NOT commit .env.

# === AI provider ===
# claude (default per activity spec) or groq (free, no card, works identically)
BRIEFING_AI=groq

# Anthropic Claude (https://console.anthropic.com → API Keys). Optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (https://console.groq.com → API Keys). Free.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === Supabase ===
# Anon/publishable key — read-only on form_submissions, with the read policy applied
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TABLE=form_submissions

# === Email senders ===
# Resend (default)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Gmail / NodeMailer (optional alternate — `--gmail` flag).
# Requires 2-step verification + an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASS_ARCA=

# === Briefing config ===
BRIEFING_TO=
BRIEFING_TZ=Asia/Manila
# Cron syntax: minute hour day month weekday
#   "*/2 * * * *"    every 2 minutes (testing)
#   "30 16 * * *"    daily at 16:30 (4:30 PM) in BRIEFING_TZ
#   "0 7 * * *"      daily at 07:00 (production default)
BRIEFING_CRON=0 7 * * *
BRIEFING_PORT=3100

# === Vercel deploy ===
# Shared secret so only Vercel Cron + your dashboard can call /api/briefing
BRIEFING_SECRET=
# Public URL of the deployed function (used by dashboards after deploy)
BRIEFING_DEPLOY_URL=
